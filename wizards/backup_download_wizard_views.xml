<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backup Reject Wizard Form View -->
    <record id="view_backup_reject_wizard_form" model="ir.ui.view">
        <field name="name">backup.reject.wizard.form</field>
        <field name="model">backup.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Backup Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="rejection_reason" 
                           placeholder="Explain why this backup request is being rejected..."
                           nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Reject Request" 
                            type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
